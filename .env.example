APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="zanshugurov07@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CORS
# Comma-separated list. Add production frontend domains in deployed environments.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-Requested-With,X-XSRF-TOKEN,X-Fingerprint-ID
CORS_MAX_AGE=0
CORS_SUPPORTS_CREDENTIALS=false

# Scribe API docs
SCRIBE_TRY_IT_OUT_BASE_URL=${APP_URL}
SCRIBE_TRY_IT_OUT_USE_CSRF=false
SCRIBE_AUTH_KEY=

# Reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# AI provider
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT=30
AI_MAX_OUTPUT_TOKENS=1200
AI_TEMPERATURE=0.1
AI_THINKING_MODE=false
AI_RATE_LIMIT_STANDARD=10
AI_RATE_LIMIT_PREMIUM=30
AI_RATE_LIMIT_ADMIN=60
AI_RATE_LIMIT_CREATOR=60

# Backward-compatible DeepSeek aliases also supported:
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# AI moderation
MODERATION_DEFAULT_MODE=medium

# Security middleware
SECURITY_TUNNEL_DOMAINS=ngrok-free.app,ngrok.io,trycloudflare.com
SECURITY_TUNNEL_WRITE_ALLOWED_PATHS=api/v1/auth/*,api/v1/profile/*,api/v1/watch-history*,api/v1/favorites*
SECURITY_BAD_USER_AGENTS=binlar,casper,checkprivilege,clshttp,cmsworldmap,diavol,dotbot,extract,feedfinder,flicky,g00g1e,harvest,heritrix,httrack,kmccrew,loader,miner,nikto,nutch,planetwork,purebot,pycurl,skygrid,sqlmap,sucker,turnit,vikspider,zmeu
SECURITY_CSP="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.tailwindcss.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https: http:; connect-src 'self' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; frame-ancestors 'none';"
SECURITY_HSTS_ENABLED=false

# Anti-scraper middleware
ANTI_SCRAPER_ADMIN_FINGERPRINTS=
ANTI_SCRAPER_INITIAL_TRUST_SCORE=100
ANTI_SCRAPER_BLOCK_THRESHOLD=20
ANTI_SCRAPER_RATE_LIMIT_PER_MINUTE=100
ANTI_SCRAPER_TRUST_TTL_DAYS=7
ANTI_SCRAPER_BLOCK_DELAY_SECONDS=1
ANTI_SCRAPER_EXPOSE_TRUST_SCORE=false

# Clerk admin authentication
# CLERK_ISSUER is visible in Clerk Dashboard, e.g. https://your-instance.clerk.accounts.dev
# CLERK_JWKS_URL usually equals ${CLERK_ISSUER}/.well-known/jwks.json
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=http://localhost:3001
CLERK_ADMIN_EMAILS=

# Optional high-quality anime backdrop source. Prefer TMDB_BEARER_TOKEN when available.
TMDB_API_KEY=
TMDB_BEARER_TOKEN=

# Optional AllAnime fallback provider (based on ani-cli scraping flow).
# Disabled by default; enable after checking playback/CORS/legal constraints in your environment.
ALLANIME_ENABLED=false
ALLANIME_BASE_HOST=allanime.day
ALLANIME_API_URL=https://api.allanime.day/api
ALLANIME_REFERER=https://youtu-chan.com
ALLANIME_MODE=sub
ALLANIME_PROXY_ENABLED=true
ALLANIME_PROXY_PUBLIC_PREFIX=/api/external/public
ALLANIME_MAX_EPISODES_PER_IMPORT=2000
